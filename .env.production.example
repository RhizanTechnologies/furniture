# Production Environment Configuration Example
# Copy to .env.production and fill in secure values before deploying.

# --- PostgreSQL Database ---
POSTGRES_USER=furniture_prod_user
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here
POSTGRES_DB=furniture_prod_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://furniture_prod_user:generate_a_secure_random_db_password_here@postgres:5432/furniture_prod_erp?schema=public

# --- Authentication & Cookies ---
JWT_SECRET=generate_a_cryptographically_secure_256bit_jwt_secret_here
JWT_EXPIRES_IN=7d
COOKIE_SECRET=generate_a_cryptographically_secure_cookie_signing_secret_here

# --- Network & CORS ---
PORT=3000
CORS_ORIGIN=https://erp.yourfurnituredomain.com

# --- Object Storage (MinIO or AWS S3) ---
MINIO_ROOT_USER=furniture_minio_admin
MINIO_ROOT_PASSWORD=generate_a_secure_random_minio_password_here
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=furniture_minio_admin
S3_SECRET_ACCESS_KEY=generate_a_secure_random_minio_password_here
S3_BUCKET=furniture-erp-uploads
S3_FORCE_PATH_STYLE=true

# --- Local Storage Fallback ---
UPLOAD_DIR=/app/uploads
