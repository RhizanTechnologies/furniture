# Database Configuration
POSTGRES_USER=furniture_user
POSTGRES_PASSWORD=furniture_pass
POSTGRES_DB=furniture_erp
POSTGRES_PORT=5436
DATABASE_URL=postgresql://furniture_user:furniture_pass@localhost:5436/furniture_erp?schema=public

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
